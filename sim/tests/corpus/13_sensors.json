{
  "display": "overlay",
  "root": [
    {
      "cells": [
        { "type": "label", "role": "eyebrow", "text": "SENSORS" },
        { "type": "label", "role": "title", "text": "传感器 / 触觉" }
      ]
    },
    {
      "cols": [ { "title": "项" }, { "title": "值", "num": true } ],
      "rows": [
        [ { "type": "label", "text": "俯仰" }, { "type": "label", "bind": "imu.pitch", "fmt": "%d deg" } ],
        [ { "type": "label", "text": "横滚" }, { "type": "label", "bind": "imu.roll", "fmt": "%d deg" } ],
        [ { "type": "label", "text": "USB插入" }, { "type": "label", "tone": "ok", "bind": "power.usb_in", "fmt": "%d" } ],
        [ { "type": "label", "text": "无线充" }, { "type": "label", "tone": "dim", "bind": "power.wireless_charging", "fmt": "%d" } ]
      ]
    },
    { "cells": [ { "type": "divider" } ] },
    {
      "cells": [
        { "type": "button", "variant": "primary", "text": "震动测试", "on_click": [ { "do": "invoke", "cmd": "device.vibrate" } ] }
      ]
    }
  ]
}
