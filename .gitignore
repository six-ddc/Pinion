# ESP-IDF build outputs / generated state
build/
build*/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old

# project-local ESP-IDF install + activation script (machine-specific paths)
.esp-idf
.idf-env.sh

# editors / tooling
.vscode/
.devcontainer/
.clangd
.cache
.DS_Store
*.pyc
*.bin
tmp/
.env

# pi-c models.json copy — contains a live API key (see pi_agent_task.c /
# pi_models_data.h header comment); pi-c's own repo gitignores the source
# file for the same reason.
main/display/screen/pi_screen/pi_models_data.h

# 火山引擎语音密钥（真钥，从模板 volc_keys.h.example 复制生成）——绝不入库。
# 全局文件名匹配：无论该头文件位于或被复制到仓库何处均被忽略。
volc_keys.h

# sim 运行产物（从仓库根目录运行 ./sim/build/pi_sim 时生成于 CWD）
/pi_sim_settings.ini
/pi_sim_sd/

# 串口采集日志（tools/serial_cap.py 的 OUT= 产物）与 python 缓存
serial*.log
__pycache__/
