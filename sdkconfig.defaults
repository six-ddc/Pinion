# pi-c PI_FEATURE_* enable set. Device now talks to the real DeepSeek API
# (models.json, openai-completions) instead of the mock — mock is deprecated.
# MODELS_JSON loads the embedded models.json catalog; COMPAT is required
# because deepseek's catalog entries carry compat.thinkingFormat/
# requiresReasoningContentOnAssistantMessages (deepseek-style reasoning needs
# request/response shaping). PARTIAL_JSON kept from the original mock-era
# enable set (streaming tool-arg parsing).
# Everything else stays at the pi-c Kconfig default (n): IMAGES/SESSION/
# PARALLEL_TOOLS/COMPACTION/SKILLS_IGNORE.
CONFIG_PI_FEATURE_PARTIAL_JSON=y
CONFIG_PI_FEATURE_MODELS_JSON=y
CONFIG_PI_FEATURE_COMPAT=y

# The 3 pi_* fonts (font_pi_mono_14/17, font_pi_clock_132) were generated by
# lv_font_conv without --no-compress, so their glyph bitmaps are LVGL's RLE
# "compressed" format (bitmap_format=1). LV_USE_FONT_COMPRESSED gates the
# decompressor in lv_draw_sw_letter.c; with it off, draw_letter_cb reads the
# compressed bytes as if they were raw bitmap data, which is what produced the
# real-device Load access fault (Guru Meditation) the first time pi_screen
# rendered a label with one of these fonts. Must stay on as long as any
# compressed font ships.
CONFIG_LV_USE_FONT_COMPRESSED=y

# ============================================================================
# 承重硬件集 —— 镜像自真机验证过的本地 sdkconfig（该文件不入库）。
# 丢失任何一项都可能导致不启动/显示错乱/字体崩溃/WiFi 不通，勿删。
# 本文件只在 sdkconfig 重新生成时生效，日常构建以本地 sdkconfig 为准。
# ============================================================================

# flash 32MB + 自定义分区表
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v1/32m.csv"

# 性能/任务
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
# mhal::sysmon 的 CPU 占用率统计依赖
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# PSRAM：HEX 200MHz + XIP（3×720×720 RGB888 帧缓冲全在 PSRAM）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_FLASH_LOAD_TO_PSRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_LINE_64B=y

# LVGL：24 位色（RGB888 面板），压缩字体解码器见文件头
CONFIG_LV_COLOR_DEPTH_24=y

# Wi-Fi：ESP32-C5 ESP-Hosted SDIO（引脚 CMD50/CLK51/D0-49/D1-34/D2-31/D3-53/RST54）
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=50
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=51
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=49
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=34
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=31
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=53
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
