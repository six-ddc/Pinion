/* 模型目录模板（含密钥）。
 *
 * 使用方法：复制本文件为同目录 pi_models_data.h（已在仓库 .gitignore 中忽略），
 * 把 apiKey 换成自己的真 key。pi_agent_task.c 直接把 PI_MODELS_JSON_TEXT 喂给
 * pi-c 的 PI_FEATURE_MODELS_JSON 加载器（pi_models_load），所以不需要任何构建
 * 系统的 EMBED_TXTFILES 步骤，也没有外部符号。
 *
 * 红线：pi_models_data.h 绝不提交入库，key 值绝不出现在日志里。
 *
 * ---------------------------------------------------------------------------
 * 内容就是一份 pi-c 格式的 models.json，minify 后转义成 C 字符串字面量。
 * 展开可读形式如下（真正写进宏的是它 `jq -c .` 之后的样子）：
 *
 *   {
 *     "providers": {
 *       "deepseek": {
 *         "baseUrl": "https://api.deepseek.com",
 *         "api": "openai-completions",
 *         "apiKey": "sk-YOUR_KEY_HERE",
 *         "models": [
 *           {
 *             "id": "deepseek-v4-pro",
 *             "name": "DeepSeek V4 Pro",
 *             "contextWindow": 1000000,
 *             "maxTokens": 384000,
 *             "input": ["text"],
 *             "reasoning": true,
 *             "cost": { "input": 1.74, "output": 3.48,
 *                       "cacheRead": 0.145, "cacheWrite": 0 },
 *             "compat": {
 *               "requiresReasoningContentOnAssistantMessages": true,
 *               "thinkingFormat": "deepseek"
 *             }
 *           }
 *         ]
 *       }
 *     }
 *   }
 *
 * 几个字段是承重的，别删：
 *   - api            —— provider 协议，DeepSeek 用 "openai-completions"。
 *   - compat.*       —— PI_FEATURE_COMPAT 靠它跟 DeepSeek 对话（把 reasoning
 *                       内容回填到 assistant message、thinking 格式方言）。缺了
 *                       多轮思考链会话会崩。
 *   - contextWindow  —— UI 的 CTX 占比显示直接读它。
 * 保留完整目录（而不是只留一个模型）才能让 pi-c 的 model.compat /
 * thinking_level_map 活着；pi_models_json_load_first 那条轻量路径不适用。
 *
 * 换模型/换 provider 时，从 pi-c 的 models.json 取对应条目照抄即可。手工维护本
 * 文件时可用这条一行命令做转义：
 *
 *   jq -c . models.json | python3 -c \
 *     "import sys; s=sys.stdin.read().strip(); \
 *      print(s.replace(chr(92),chr(92)*2).replace(chr(34),chr(92)+chr(34)))"
 *
 * SPDX-License-Identifier: MIT */
#ifndef PI_MODELS_DATA_H
#define PI_MODELS_DATA_H

#define PI_MODELS_JSON_TEXT                                                                       \
    "{\"providers\":{\"deepseek\":{\"baseUrl\":\"https://api.deepseek.com\",\"api\":\"openai-"     \
    "completions\",\"apiKey\":\"sk-YOUR_KEY_HERE\",\"models\":[{\"id\":"                           \
    "\"deepseek-v4-pro\",\"name\":\"DeepSeek V4 Pro\",\"contextWindow\":1000000,\"maxTokens\":"     \
    "384000,\"input\":[\"text\"],\"reasoning\":true,\"cost\":{\"input\":1.74,\"output\":3.48,"      \
    "\"cacheRead\":0.145,\"cacheWrite\":0},\"compat\":{\"requiresReasoningContentOnAssistantMess"   \
    "ages\":true,\"thinkingFormat\":\"deepseek\"}},{\"id\":\"deepseek-v4-flash\",\"name\":"         \
    "\"DeepSeek V4 Flash\",\"contextWindow\":1000000,\"maxTokens\":384000,\"input\":[\"text\"],"    \
    "\"reasoning\":true,\"cost\":{\"input\":0.14,\"output\":0.28,\"cacheRead\":0.028,\"cacheWrite"  \
    "\":0},\"compat\":{\"requiresReasoningContentOnAssistantMessages\":true,\"thinkingFormat\":"    \
    "\"deepseek\"}}]}}}"

#endif /* PI_MODELS_DATA_H */
